# ---------------------------------------------------------------------------
# DATABASE: switched off for now (quote requests are emailed only).
# To turn it back on, uncomment these, uncomment the DATABASE blocks in
# app/api/leads/route.ts and run `npm run db:migrate`.
# ---------------------------------------------------------------------------
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=flawless_detailing
# DB_USER=root
# DB_PASSWORD=

# Public origin used by sitemap, robots and canonical URLs.
# Set this to the staging URL on staging so previews don't advertise production.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Staging only: keep the site out of search results. Set to "false" at launch.
NEXT_PUBLIC_NOINDEX=true

# ---------------------------------------------------------------------------
# QUOTE REQUESTS GO BY EMAIL. Without SMTP_HOST the form shows an error to the
# visitor (and logs the lead on the server), so fill these in.
#
# Gmail example (needs 2-Step Verification, then create an "App password"):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465            (465 = SSL, 587 = STARTTLS)
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=the-16-character-app-password
# Gmail always sends as the authenticated account, so MAIL_FROM can stay empty.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Where quote requests are delivered:
LEAD_NOTIFY_TO=flawlessdetailing303@gmail.com
